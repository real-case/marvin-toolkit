{
  "type": "object",
  "additionalProperties": false,
  "required": ["status", "summary", "tests"],
  "properties": {
    "status": { "type": "string", "enum": ["done", "failed"] },
    "summary": { "type": "string" },
    "tests": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "criteria"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "criteria": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "untestable": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["criterion", "reason"],
        "properties": {
          "criterion": { "type": "string", "minLength": 1 },
          "reason": { "type": "string", "minLength": 1 }
        }
      }
    },
    "failure": { "type": "string" }
  }
}
