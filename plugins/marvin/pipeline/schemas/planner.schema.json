{
  "type": "object",
  "additionalProperties": false,
  "required": ["status", "summary"],
  "properties": {
    "status": { "type": "string", "enum": ["needs_input", "spec_ready", "failed"] },
    "summary": { "type": "string", "maxLength": 600 },
    "questions": {
      "type": "array",
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "text", "recommendation", "why_blocking"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "text": { "type": "string", "minLength": 1 },
          "options": { "type": "array", "items": { "type": "string" } },
          "recommendation": { "type": "string", "minLength": 1 },
          "why_blocking": { "type": "string", "minLength": 1 }
        }
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "slug", "risk", "files", "criteria", "sealed"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "slug": { "type": "string", "minLength": 1 },
        "risk": { "type": "string", "enum": ["low", "medium", "high", "critical"] },
        "files": { "type": "integer" },
        "criteria": { "type": "integer" },
        "sealed": { "type": "boolean" },
        "critic": {
          "type": "string",
          "enum": ["PASS", "PASS WITH WARNINGS", "BLOCK", "UNABLE"]
        },
        "overrides": { "type": "array", "items": { "type": "string" } }
      }
    },
    "assumptions": { "type": "array", "items": { "type": "string" } },
    "failure": { "type": "string" }
  }
}
